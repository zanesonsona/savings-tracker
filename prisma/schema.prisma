// Prisma schema for Savings Tracker.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- Phase 2: accounts & per-account ownership (D14–D17) ---
// Every data model belongs to exactly one User via `userId` (D16). The column
// was nullable during the T21–T26 rollout; T26 scoped all routes to the
// session account and tightened it to required — a row without an owner can no
// longer be written (§5 target).

model User {
  id             Int            @id @default(autoincrement())
  username       String         @unique // compared case-insensitively in the API
  passwordHash   String // scrypt (node:crypto) — D17
  role           String         @default("USER") // "ADMIN" | "USER" (validated in API)
  status         String         @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED" (validated in API)
  createdAt      DateTime       @default(now())
  decidedAt      DateTime?
  categories     Category[]
  incomes        Income[]
  expenses       Expense[]
  savingsEntries SavingsEntry[]
}

model Category {
  id             Int            @id @default(autoincrement())
  name           String
  percentage     Float
  kind           String         @default("EXPENSE") // "EXPENSE" | "SAVINGS" (validated in API)
  color          String?
  createdAt      DateTime       @default(now())
  userId         Int
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses       Expense[]
  savingsEntries SavingsEntry[]

  @@unique([userId, name])
  @@index([userId])
}

model Income {
  id          Int      @id @default(autoincrement())
  amountCents Int
  source      String?
  date        DateTime // UTC midnight
  note        String?
  createdAt   DateTime @default(now())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([userId])
}

model Expense {
  id          Int      @id @default(autoincrement())
  amountCents Int
  date        DateTime
  note        String?
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([categoryId])
  @@index([userId])
}

model SavingsEntry {
  id          Int      @id @default(autoincrement())
  amountCents Int
  direction   String // "DEPOSIT" | "WITHDRAWAL"
  date        DateTime
  note        String?
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([categoryId])
  @@index([userId])
}
