# Copy to .env for local development.
# SQLite database file (lives at prisma/dev.db because the path is relative to prisma/schema.prisma).
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies (HMAC-SHA256).
# Required in production — the server refuses to start without it (D17).
# In development an insecure fixed fallback is used with a console warning.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=""
